# Containerized Streamlit, run alongside pstad + the static UI — the actual
# point of this file: prove the OCI VM can host a Streamlit app in Docker
# before doing the same for the real (non-sandbox) project. No test-running
# code here; this just talks to pstad over HTTP, same as public/index.html.

FROM python:3.12-slim

WORKDIR /app
COPY streamlit/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY streamlit/app.py .

EXPOSE 8501

# --server.address=0.0.0.0 is the one every Docker-Streamlit guide leads
# with, for good reason: Streamlit binds to localhost by default, which
# inside a container means "unreachable from anywhere, including the host's
# own port mapping" — not a crash, just silent connection-refused, so it's
# an easy thing to ship broken.
# --server.headless=true stops Streamlit prompting for an email on first run
# and trying to open a local browser that doesn't exist in a container.
# --browser.gatherUsageStats=false skips a network call home at startup.
ENTRYPOINT ["streamlit", "run", "app.py", \
    "--server.address=0.0.0.0", \
    "--server.port=8501", \
    "--server.headless=true", \
    "--browser.gatherUsageStats=false"]
